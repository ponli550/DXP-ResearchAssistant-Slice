# Copy this to .env and fill in ONE key. `python -m ra serve` reads it, so answers and the workspace assistant switch on with no code change.
# With no key the app still runs: answers quote the closest sentence, and the assistant follows fixed steps.

# Claude (needs the extra: pip install .[claude])
# ANTHROPIC_API_KEY=

# Or any OpenAI-compatible endpoint
# HERMES_API_KEY=
# HERMES_BASE_URL=https://inference-api.nousresearch.com/v1
# HERMES_MODEL=qwen/qwen3.8-27b

# Set this to something random before sharing the URL; the default is "demo"
# ADMIN_TOKEN=
